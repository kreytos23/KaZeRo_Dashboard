# Rama Neon "development". Los llena `pnpm bd:configurar desarrollo`, nunca a mano.
DATABASE_URL=postgresql://kazero_app:***@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_OWNER=postgresql://neondb_owner:***@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# 32 bytes en base64. Distinta por entorno.
KAZERO_TOTP_KEY=
# Host del endpoint de producción: la guarda exige KAZERO_OTRA_BD=confirmo para tocarlo.
KAZERO_HOST_PROD=
# Fotos de pieza (Plan 2.2). "blob" (por defecto, obligatorio en Vercel) usa el store privado del entorno
# con su token; "disco" (solo local/E2E, prohibido en Vercel) guarda en KAZERO_DIR_IMAGENES (ruta absoluta);
# "memoria" (solo pruebas). Sin token, subir o ver fotos falla cerrado.
BLOB_READ_WRITE_TOKEN=
KAZERO_ALMACEN_IMAGENES=
KAZERO_DIR_IMAGENES=
