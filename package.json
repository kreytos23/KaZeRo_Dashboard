{
  "name": "kazero-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integracion": "tsx scripts/test-neon.ts integracion",
    "test:e2e": "tsx scripts/test-neon.ts e2e",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx scripts/db-migrar.ts",
    "admin:crear": "tsx scripts/crear-admin.ts",
    "bd:configurar": "tsx scripts/configurar-bd.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.3",
    "next": "16.4.0",
    "otpauth": "9.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "neon": "8.0.12",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vercel": "63.1.0",
    "vitest": "5.0.3"
  }
}
